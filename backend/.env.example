NODE_ENV=development
PORT=3001
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:5173

# --- ClamAV (virus scanning sidecar — see docker-compose.yml) ---
# Defaults work when running `docker compose up -d clamav` on the same host.
# In production with backend in compose, set CLAMAV_HOST=clamav.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
